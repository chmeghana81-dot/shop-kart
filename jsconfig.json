{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*":            ["src/*"],
      "@components/*":  ["src/components/*"],
      "@pages/*":       ["src/pages/*"],
      "@layouts/*":     ["src/layouts/*"],
      "@redux/*":       ["src/redux/*"],
      "@services/*":    ["src/services/*"],
      "@hooks/*":       ["src/hooks/*"],
      "@utils/*":       ["src/utils/*"],
      "@constants/*":   ["src/constants/*"],
      "@assets/*":      ["src/assets/*"],
      "@styles/*":      ["src/styles/*"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "checkJs": false
  },
  "include": ["src"]
}
